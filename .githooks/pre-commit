#!/bin/sh
# Layer 2 of herdr-tokens' fixture PII defence (see README, "Contributing /
# working on fixtures"). Layer 1 is scripts/capture-fixture.sh sanitizing at
# capture time -- that remains the primary defence, and unsanitized data
# should never reach the working tree at all. This hook is what stops such
# data from reaching *local history* if layer 1 is ever bypassed: once a
# commit exists, a push is one command away, and the exposure becomes a
# matter of when, not if -- the same exposure a sibling project paid for
# with a 14-commit filter-branch rewrite. Layer 3 (the CI job) is only a
# backstop for a commit made with --no-verify, or a clone that never ran
# `make install-hooks`; it is the last line, not the first.
#
# Deliberately inspects the STAGED blob via `git show :<path>`, not the
# working tree: staging a bad fixture and then cleaning up the file on disk
# afterwards must still be caught, because it is the staged content that
# actually gets committed.
#
# THE CHECK ITSELF is a CLOSED POSITIVE SCHEMA (internal/herdrapi/schema.go),
# not a denylist: it asserts every field present in a staged testdata/ blob
# is one this schema recognises AND has the exact shape (a literal, an enum,
# or a regex) that field is allowed to have, rather than scanning for a
# fixed list of known-bad shapes. That inversion is the fix for a specific,
# demonstrated failure of the denylist this hook used to run inline (six
# grep-based rules, one per known-bad shape): two independently written
# audit tools each cleared their own repository's placeholder convention and
# each flagged the OTHER's as a leak, because a scan for known-bad shapes
# cannot distinguish a leak from its own fix. See the CHANGELOG "Known
# limitation" section for the full account. Those six rules are DELETED
# here, not kept alongside the schema: every guarantee they provided (an
# unrecognised path/tilde-path/title/UUID/term_ shape anywhere in the tree
# still fails) is strictly subsumed by the closed schema, which additionally
# catches a field the old rules never knew to look for at all. This hook
# retains exactly ONE rule from the old set below (the committing account
# name, checked as a raw substring anywhere in the blob): that check's
# guarantee is NOT subsumed by the schema, because several schema fields
# (agent_session.kind, agent_session.source, a layout split's "direction"
# and "id", the top-level "version") are deliberately type-checked only, not
# pattern-constrained -- see schema.go's header for why -- so an account
# name landing in one of those would validate cleanly against the schema
# while still being a real leak. A raw substring scan has no notion of
# "known-bad shape" to be blind to, so it stays as a cheap, cross-cutting
# second check with a genuinely different guarantee than the schema, not a
# second copy of the same one.
#
# FAIL CLOSED, not open. An earlier version of this hook treated any
# non-zero exit from grep -- "no match" (1), "binary/NUL input" (also 1 on
# most greps, without even scanning), a genuine error (2+), or "grep isn't
# on PATH at all" -- as equally meaning "this file is clean". That let a
# staged file containing a real client path through as long as it also
# contained a NUL byte, because the NUL byte made grep bail out before it
# ever looked at the text. A guard that can be silently switched off by a
# stray byte, or by a broken toolchain, is worse than no guard: it produces
# false confidence. So, throughout this script:
#   - every external command it needs is checked present on PATH up front;
#     a missing one refuses the commit, it does not skip the check.
#   - every grep/tr/wc/git/id/go whose result is a security decision has
#     its exit status captured explicitly via `set +e; <cmd>; rc=$?; set
#     -e` (never bare `|| :`) and passed to `require_ok`, which itself
#     returns non-zero on anything unexpected -- and every call site acts
#     on that return value (`require_ok ... || continue`), not just on the
#     side-effecting infra_fail it triggers. That return value is checked
#     everywhere uniformly, including the outer, candidate-producing grep
#     for each rule, so a scan that could not be trusted never lets later
#     code in the same file act as though it ran cleanly.
#   - every staged testdata/ file is explicitly checked for NUL bytes
#     before any text tool ever touches it (testdata/ is JSON by
#     definition; a NUL byte there is both unscannable and not something
#     scripts/capture-fixture.sh would ever produce), and a NUL byte
#     refuses the commit rather than being silently skipped or stripped.
#   - the schema check specifically does NOT trust a bare exit code from
#     `go build`/the compiled checker at face value where a richer signal
#     is available: exit 1 from the checker binary is cross-checked against
#     actually having produced >=1 "SCHEMA_VIOLATION" line before being
#     treated as a genuine finding (see below and cmd/schema-check's own
#     comments for why this matters -- `go run` would have collapsed exit
#     codes 1 and 2 into one indistinguishable value, which is exactly why
#     this hook builds a real binary with `go build` instead of using
#     `go run` per staged file).
#   - no step is a multi-command PIPELINE whose overall exit status is
#     checked as if it reflected every command in it. A shell pipeline's
#     exit status is only that of its LAST command, so `a | b; rc=$?`
#     observes only `b`'s failures, never `a`'s. This deliberately does NOT
#     reach for `set -o pipefail` to fix that: pipefail is a bash/ksh/zsh
#     extension, not POSIX, and this hook is `#!/bin/sh` -- on Debian/
#     Ubuntu (where CI, and many contributors, run) `/bin/sh` is dash,
#     which does not support it, so the hook would error out there while
#     appearing to work on a macOS contributor's machine. Every place that
#     pipes one command into another instead uses separate steps with an
#     intermediate file, each with its own captured, checked exit status.
#
# POSIX sh only, and deliberately avoids GNU-only regex behaviour, since
# this runs on whatever grep a developer's machine has -- BSD grep, a ugrep
# shim, etc. -- not necessarily GNU grep.

set -eu

# --- Dependency preflight --------------------------------------------------
# Refuse rather than silently skip verification if any tool this hook needs
# is missing. `command -v` also catches the case where a name resolves to
# something that isn't actually executable. `go` is required to build the
# schema checker (internal/herdrapi/schema.go via cmd/schema-check); there is
# no shell-only fallback -- see the header comment on why re-implementing the
# schema in POSIX sh was rejected (it would be a second copy of the rules
# with its own chance to drift from the Go source of truth).
for dep in git mktemp id grep tr wc rm printf go; do
	if ! command -v "$dep" >/dev/null 2>&1; then
		printf 'pre-commit: required command "%s" not found on PATH -- refusing to commit\n' "$dep" >&2
		printf '(cannot verify testdata/ fixtures are sanitized without it; fix PATH and retry)\n' >&2
		exit 1
	fi
done

set +e
tmp=$(mktemp -d)
mktemp_rc=$?
set -e
if [ "$mktemp_rc" -ne 0 ] || [ -z "$tmp" ]; then
	printf 'pre-commit: mktemp -d failed -- refusing to commit\n' >&2
	exit 1
fi
trap 'rm -rf "$tmp"' EXIT

report() {
	# report <file> <line> <rule> <detail> -- a positive finding.
	printf 'BLOCKED %s:%s [%s] %s\n' "$1" "$2" "$3" "$4" >&2
	: >"$tmp/failed"
}

infra_fail() {
	# infra_fail <detail> -- a tool we needed, in order to certify a file
	# clean, did not behave as expected. Treated exactly like a positive
	# finding: refuse, never assume clean.
	printf 'BLOCKED [INFRA] %s\n' "$1" >&2
	: >"$tmp/failed"
}

refusal_message() {
	{
		echo ""
		echo "pre-commit: refusing to commit -- see BLOCKED line(s) above."
		echo "If any are [INFRA]: a tool this hook needs did not behave as expected"
		echo "(missing, or failed while scanning), so this hook could not certify the"
		echo "staged testdata/ file(s) as clean, and refuses rather than guessing."
		echo "Otherwise: do not hand-edit the fixture to patch this -- it is not a fix,"
		echo "because the next capture silently overwrites hand edits anyway. Instead,"
		echo "re-run:"
		echo ""
		echo "    ./scripts/capture-fixture.sh testdata/<file>.json"
		echo ""
		echo "and re-stage the regenerated, sanitized file. If the BLOCKED line names a"
		echo "SCHEMA_VIOLATION and re-capturing does not fix it, the fixture needs a new"
		echo "field or shape classified in internal/herdrapi/schema.go -- that schema is"
		echo "CLOSED deliberately; a field it has never seen is refused until a human"
		echo "decides how it should be validated, not silently accepted."
		echo ""
		echo "(Emergency bypass: git commit --no-verify -- but the fixtures-are-sanitized CI"
		echo "job still runs and will still fail; it's a backstop, not a way around this.)"
	} >&2
}

require_ok() {
	# require_ok <rc> <space-separated allowed rcs> <description>
	# Returns 0 if $1 is one of the allowed values in $2. Otherwise calls
	# infra_fail and returns 1 -- every call site acts on this return
	# value (typically `require_ok ... || continue`) rather than only
	# relying on infra_fail's side effect, so a scan that could not be
	# trusted can never let the caller act as though it succeeded.
	for _allowed in $2; do
		if [ "$1" = "$_allowed" ]; then
			return 0
		fi
	done
	infra_fail "$3 (exit $1)"
	return 1
}

# --- Discover staged testdata/ files ---------------------------------------
# If git itself fails here, we have no reliable file list at all -- refuse
# immediately rather than falling through to "nothing staged, exit 0".
set +e
git diff --cached --name-only --diff-filter=d -- testdata/ >"$tmp/staged" 2>"$tmp/staged.err"
staged_rc=$?
set -e
if [ "$staged_rc" -ne 0 ]; then
	infra_fail "git diff --cached failed (exit $staged_rc); cannot confirm nothing unsanitized is staged under testdata/"
	refusal_message
	exit 1
fi

if [ ! -s "$tmp/staged" ]; then
	exit 0
fi

# --- Build the schema checker once, reused for every staged file below -----
# Built into $tmp (never bin/, which is gitignored build output, not
# something a hook should leave behind or race with a concurrent `make
# build`). A real binary, not `go run` per file: `go run` collapses every
# non-zero child exit code into its own generic exit status 1 and discards
# the original value -- confirmed directly against this exact tool, where a
# genuine schema violation (intended exit 1) and a file this tool could not
# even read or parse (intended exit 2) both come back from `go run` as
# indistinguishable exit 1. A real binary preserves the original exit code,
# which is what lets the rc-based branches below actually discriminate.
set +e
git rev-parse --show-toplevel >"$tmp/root" 2>"$tmp/root.err"
root_rc=$?
set -e
require_ok "$root_rc" "0" "git rev-parse --show-toplevel failed; cannot locate the module to build the schema checker" || {
	refusal_message
	exit 1
}
repo_root=$(cat "$tmp/root")
if [ -z "$repo_root" ]; then
	infra_fail "git rev-parse --show-toplevel returned nothing; cannot locate the module to build the schema checker"
	refusal_message
	exit 1
fi

set +e
(cd "$repo_root" && go build -o "$tmp/schema-check" ./cmd/schema-check) >"$tmp/build.out" 2>"$tmp/build.err"
build_rc=$?
set -e
if [ "$build_rc" -ne 0 ]; then
	infra_fail "go build ./cmd/schema-check failed (exit $build_rc); cannot verify staged fixtures without it -- see below"
	cat "$tmp/build.err" >&2
	refusal_message
	exit 1
fi

set +e
me=$(id -un)
id_rc=$?
set -e
if [ "$id_rc" -ne 0 ] || [ -z "$me" ]; then
	infra_fail "id -un failed or returned nothing; cannot check for the committing user's account name"
	me=""
fi

while IFS= read -r f; do
	[ -n "$f" ] || continue

	blob="$tmp/blob"
	set +e
	git show ":$f" >"$blob" 2>"$tmp/blob.err"
	show_rc=$?
	set -e
	if [ "$show_rc" -ne 0 ]; then
		infra_fail "git show :$f failed (exit $show_rc); cannot verify this staged file is sanitized"
		continue
	fi

	# --- Binary / NUL-byte guard -------------------------------------
	# testdata/ is JSON by definition. Compare total byte count against
	# the byte count with NUL bytes stripped; any difference means a NUL
	# byte is present. This deliberately does not use grep at all here
	# (grep is exactly the tool that silently gave up on binary input in
	# the bug this fixes), and does not use tr's output to "clean" the
	# file for scanning -- a NUL byte is refused outright, never
	# silently stripped and scanned anyway, because that would hide the
	# anomaly instead of surfacing it. It also guarantees the schema
	# checker (which decodes the blob as JSON/UTF-8) is never handed
	# content that could not possibly be valid JSON to begin with.
	#
	# The stripping-and-counting step is intentionally two separate
	# commands (tr to a file, then wc on that file) rather than
	# `tr ... | wc -c`: a pipeline's exit status is only that of its
	# last command, so piping would silently stop observing whether tr
	# itself failed. See the file header for why this doesn't reach for
	# `set -o pipefail` instead.
	set +e
	total=$(wc -c <"$blob")
	wc_rc=$?
	set -e
	require_ok "$wc_rc" "0" "wc failed sizing $f" || continue

	set +e
	LC_ALL=C tr -d '\000' <"$blob" >"$tmp/stripped"
	tr_rc=$?
	set -e
	require_ok "$tr_rc" "0" "tr failed stripping NUL bytes from $f" || continue

	set +e
	stripped=$(wc -c <"$tmp/stripped")
	stripped_wc_rc=$?
	set -e
	require_ok "$stripped_wc_rc" "0" "wc failed sizing the NUL-stripped copy of $f" || continue

	if [ "$total" -ne "$stripped" ]; then
		report "$f" "-" "BINARY_CONTENT" "staged content contains a NUL byte; fixtures under testdata/ must be UTF-8 JSON produced by scripts/capture-fixture.sh -- a binary file here cannot be sanitized or scanned, so it is refused rather than skipped"
		continue
	fi

	# --- Rule: no occurrence of the committing user's own account name.
	# `git config user.name` is not reliable for this (it's freely set and
	# may not match the machine account at all); the machine account name
	# via `id -un` is what would actually appear in a captured path. Kept
	# alongside the schema check below (not subsumed by it -- see the file
	# header) as a cheap, cross-cutting raw substring scan.
	case "$me" in
	user | runner | "") ;; # these ARE the sanctioned placeholders; nothing to guard against
	*)
		set +e
		grep -nF "$me" "$blob" >"$tmp/cand_user" 2>"$tmp/cand_user.err"
		rc=$?
		set -e
		require_ok "$rc" "0 1" "grep (account name) failed scanning $f" || continue
		while IFS=: read -r lineno rest; do
			[ -n "$lineno" ] || continue
			report "$f" "$lineno" "REAL_USERNAME" "line contains committing user's account name ($me)"
		done <"$tmp/cand_user"
		;;
	esac

	# --- Closed positive schema check (internal/herdrapi/schema.go) ---
	# See the file header for why this replaced six inline denylist rules
	# instead of running alongside them, and why it cross-checks the
	# checker's exit code against actually having produced a
	# "SCHEMA_VIOLATION" line rather than trusting the exit code alone.
	set +e
	"$tmp/schema-check" "$blob" >"$tmp/schema.out" 2>"$tmp/schema.err"
	schema_rc=$?
	set -e

	case "$schema_rc" in
	0)
		if [ -s "$tmp/schema.out" ] || [ -s "$tmp/schema.err" ]; then
			infra_fail "schema-check exited 0 for $f but printed output; treating an unexplained result as untrustworthy rather than clean"
		fi
		;;
	1)
		set +e
		grep -c '^SCHEMA_VIOLATION	' "$tmp/schema.err" >"$tmp/violation_count" 2>"$tmp/violation_count.err"
		count_rc=$?
		set -e
		# grep -c exits 1 (not an error) when it finds zero matching
		# lines, so "0 1" are both acceptable exit statuses here; what
		# matters is the COUNT recorded in violation_count either way.
		require_ok "$count_rc" "0 1" "grep failed counting SCHEMA_VIOLATION lines for $f" || continue
		n=$(cat "$tmp/violation_count")
		if [ "$n" -lt 1 ]; then
			infra_fail "schema-check exited 1 for $f but produced no SCHEMA_VIOLATION line -- this is a build/runtime problem with the checker itself, not a confirmed fixture defect, so it is refused rather than assumed clean"
		else
			while IFS="$(printf '\t')" read -r _tag _path detail; do
				[ -n "$_tag" ] || continue
				report "$f" "-" "SCHEMA_VIOLATION" "$detail"
			done <"$tmp/schema.err"
		fi
		;;
	*)
		infra_fail "schema-check exited $schema_rc for $f (want 0 clean or 1 violations-found); cannot certify this file"
		cat "$tmp/schema.err" >&2
		;;
	esac
done <"$tmp/staged"

if [ -f "$tmp/failed" ]; then
	refusal_message
	exit 1
fi

exit 0
